# TruckTap Team Sync server
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/trucktap.db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,trucktap://app,null
# Optional: point at the built PWA (defaults to ../dist when run from server/)
# WEB_DIST=../dist
NODE_ENV=production
